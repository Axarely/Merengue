{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Merengue: compilar",
      "type": "shell",
      "command": "make",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Merengue: ejecutar la receta abierta (todas las fases)",
      "type": "shell",
      "command": "make && ./merengue \"${relativeFile}\"",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Merengue: ejecutar la receta abierta (solo salida)",
      "type": "shell",
      "command": "make && ./merengue -q \"${relativeFile}\"",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Merengue: correr todas las pruebas",
      "type": "shell",
      "command": "make pruebas",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
